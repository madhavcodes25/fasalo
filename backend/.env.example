# Port the backend API listens on
PORT=4000

# JWT signing secret (rotate in production via secrets manager)
JWT_SECRET=dev-insecure-change-me

# --- Database (Phase 0: file-backed JSON store; Phase 1+: PostgreSQL) ---
# When DATABASE_URL is set, the store can be pointed at Postgres later.
DATABASE_URL=postgresql://fasalo:fasalo@localhost:5432/fasalo

# --- Node environment ---
NODE_ENV=development
