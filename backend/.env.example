Backend URL (used by frontend dev proxy)
NEXT_PUBLIC_BACKEND_URL=http://localhost:4000

# Port the backend API listens on
PORT=4000

# --- Database (Phase 0: SQLite fallback; Phase 1+: PostgreSQL) ---
# When DATABASE_URL is set, it takes precedence (pg-format).
DATABASE_URL=postgresql://fasalo:fasalo@localhost:5432/fasalo

# --- Node environment ---
NODE_ENV=development
